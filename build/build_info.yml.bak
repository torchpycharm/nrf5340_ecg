cmake:
  application:
    source-dir: 'C:/ncs/v3.1.1/zephyr/share/sysbuild'
  board:
    name: 'nrf5340dk'
    path:
     - 'C:/ncs/v3.1.1/zephyr/boards/nordic/nrf5340dk'
    qualifiers: 'nrf5340/cpuapp/ns'
    revision: ''
  images:
   - name: 'nrf5340_ecg'
     source-dir: 'D:/CEG/nrf5340_ecg'
     type: 'MAIN'
  kconfig:
    files:
     - 'D:/CEG/nrf5340_ecg/build/_sysbuild/empty.conf'
     - 'D:/CEG/nrf5340_ecg/build/_sysbuild/empty.conf'
    user-files:
     - 'D:/CEG/nrf5340_ecg/build/_sysbuild/empty.conf'
  sysbuild: 'true'
version: '0.1.0'
west:
  command: 'C:\ncs\toolchains\c1a76fddb2\opt\bin\Scripts\west build --build-dir d:/CEG/nrf5340_ecg/build d:/CEG/nrf5340_ecg --pristine --board nrf5340dk/nrf5340/cpuapp/ns --sysbuild --'
  topdir: 'c:\ncs\v3.1.1'
  version: '1.4.0'
